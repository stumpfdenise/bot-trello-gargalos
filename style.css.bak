body {
  background: #020c2b;
  color: white;
  font-family: Arial, Helvetica, sans-serif;
  margin: 0;
  padding: 40px;
}

.container {
  max-width: 1200px;
  margin: auto;
}

.bot {
  font-size: 64px;
  margin-bottom: 12px;
}

h1 {
  font-size: 56px;
  margin-bottom: 10px;
}

.subtitulo {
  color: #94a3b8;
  margin-bottom: 24px;
}

.card {
  background: #1e293b;
  border-radius: 18px;
  padding: 28px;
  margin-bottom: 24px;
}

.alerta {
  border-left: 8px solid #ef4444;
}

.ok {
  border-left: 8px solid #22c55e;
}

.numero {
  font-size: 54px;
  font-weight: bold;
  margin-top: 16px;
}

.gargalo-item {
  background: #0f172a;
  border: 1px solid #334155;
  border-left: 6px solid #ef4444;
  border-radius: 12px;
  padding: 14px 16px;
  margin-top: 12px;
}

.gargalo-nome {
  font-weight: bold;
  font-size: 18px;
  margin-bottom: 6px;
}

.gargalo-dias {
  color: #fca5a5;
  font-size: 14px;
}

.resumo {
  display: flex;
  gap: 16px;
  margin: 24px 0;
}

.resumo-card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 14px;
  padding: 16px 20px;
  min-width: 160px;
}

.resumo-card span {
  display: block;
  color: #94a3b8;
  font-size: 14px;
  margin-bottom: 8px;
}

.resumo-card strong {
  font-size: 32px;
}

.status-geral {
  background: #1e293b;
  border-radius: 16px;
  padding: 20px 24px;
  margin-bottom: 24px;
  border-left: 8px solid #64748b;
}

.status-geral.verde {
  border-left-color: #22c55e;
}

.status-geral.amarelo {
  border-left-color: #facc15;
}

.status-geral.vermelho {
  border-left-color: #ef4444;
}

.botao-atualizar {
  background: #38bdf8;
  color: #0f172a;
  border: none;
  padding: 12px 18px;
  border-radius: 10px;
  font-weight: bold;
  cursor: pointer;
  margin-bottom: 24px;
  transition: 0.2s;
}

.botao-atualizar:hover {
  transform: scale(1.03);
}

.botao-impedimento {
  background: #f59e0b;
  color: white;
  border: none;
  padding: 10px 14px;
  border-radius: 8px;
  cursor: pointer;
  margin-top: 14px;
  font-weight: bold;
}

.campo-impedimento {
  width: 100%;
  margin-top: 12px;
  background: #020617;
  border: 1px solid #334155;
  border-radius: 8px;
  padding: 12px;
  color: white;
  min-height: 90px;
  resize: vertical;
}